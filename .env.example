# Copiez ce fichier en ".env" pour personnaliser la configuration (optionnel).
# Une variable deja definie dans le shell l'emporte sur ce fichier.

# Port d'ecoute
PORT=3000

# Environnement : development (defaut) ou production
NODE_ENV=development

# Fichier de la base SQLite, relatif a la racine du projet. ":memory:" = base jetable.
# `npm run db:reset` supprime ce fichier pour repartir des donnees de demonstration.
DB_PATH=data/atrium.db

# Dossier du journal des requetes SQL (lu par `npm run forensic`)
LOG_DIR=logs

# Duree d'une session, en heures
SESSION_TTL_HOURS=8

# Cookie de session "Secure" (a activer derriere HTTPS). Defaut : true en production.
COOKIE_SECURE=false

# A activer derriere un reverse proxy pour que req.ip soit l'adresse du client
TRUST_PROXY=false

# Affiche les comptes de demo (identifiants compris) sur l'ecran de connexion.
# Defaut : true hors production. NE JAMAIS activer hors labo.
DEMO_ACCOUNTS=true

# Cout bcrypt (10 = valeur usuelle)
BCRYPT_ROUNDS=10

# Limitation des essais de connexion : N echecs par (IP, identifiant) sur la fenetre
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
